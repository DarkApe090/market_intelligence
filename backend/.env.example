DATABASE_URL=postgresql://postgres:postgres@localhost:5433/market-intelligence
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback
# No Google Cloud, adiciona também http://127.0.0.1:8000/google/callback (o host do pedido é o URI exacto).
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=7

# Produção (HTTPS, domínio público):
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=            # chave em https://console.mistral.ai
# LLM_MODEL=mistral-small-latest
# LLM_TIMEOUT=60
# GOOGLE_REDIRECT_URI=https://api.seudominio.com/google/callback
# FRONTEND_URL=https://seudominio.com
# ALLOWED_ORIGINS=https://seudominio.com
# TOKEN_ENCRYPTION_KEY=  # chave Fernet estável; não regenerar entre deploys
# Com URLs https o cookie passa a Secure; se o site e a API tiverem hosts diferentes, SameSite=None.
# No Google Cloud: URI de redirecionamento = GOOGLE_REDIRECT_URI; origens JS = FRONTEND_URL;
# política https://api.seudominio.com/privacidade e termos https://api.seudominio.com/termos
# No frontend build: VITE_API_URL=https://api.seudominio.com
